<?xml version="1.0" encoding="utf-8"?><!-- Strings for the refuel event list screen. -->
<resources>

    <string name="refuel_title">Recent Refuels</string>

    <!-- Empty state shown at the end of the list -->
    <string name="refuel_list_end_title">Refuels end here</string>
    <string name="refuel_list_end_subtitle">Register new refuels to show up here</string>

    <!-- Overflow menu action that enters multi-select mode -->
    <string name="refuel_select_action">Select events</string>

    <!-- Title of the app bar while events are being selected -->
    <plurals name="refuel_selection_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>

    <!-- Confirmation dialog for deleting every selected event -->
    <plurals name="refuel_delete_selected_title">
        <item quantity="one">Delete selected event?</item>
        <item quantity="other">Delete %1$d selected events?</item>
    </plurals>

</resources>
