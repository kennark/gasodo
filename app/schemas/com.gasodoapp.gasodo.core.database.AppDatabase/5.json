        "viewName": "AllEventsBaseColumnsView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT id, 'REFUEL' as eventType, date, mileage, saved_location_id, photo_uris, notes\n        FROM refuel_events\n        UNION ALL\n        SELECT event_id, 'MAINTENANCE' as eventType, date, mileage, saved_location_id, photo_uris, notes\n        FROM maintenance_events\n        UNION ALL\n        SELECT id, 'INSPECTION' as eventType, date, mileage, saved_location_id, photo_uris, notes\n        FROM inspection_events"
